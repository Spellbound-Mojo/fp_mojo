"""A finite type tree: 64 nested binds, distinct from runtime loop depth."""
from state_machine import pure, bind, run
from composition import Add
from foundation import check

def main():
    var p0 = pure[Int](0)
    var p1 = bind(p0^, Add())
    var p2 = bind(p1^, Add())
    var p3 = bind(p2^, Add())
    var p4 = bind(p3^, Add())
    var p5 = bind(p4^, Add())
    var p6 = bind(p5^, Add())
    var p7 = bind(p6^, Add())
    var p8 = bind(p7^, Add())
    var p9 = bind(p8^, Add())
    var p10 = bind(p9^, Add())
    var p11 = bind(p10^, Add())
    var p12 = bind(p11^, Add())
    var p13 = bind(p12^, Add())
    var p14 = bind(p13^, Add())
    var p15 = bind(p14^, Add())
    var p16 = bind(p15^, Add())
    var p17 = bind(p16^, Add())
    var p18 = bind(p17^, Add())
    var p19 = bind(p18^, Add())
    var p20 = bind(p19^, Add())
    var p21 = bind(p20^, Add())
    var p22 = bind(p21^, Add())
    var p23 = bind(p22^, Add())
    var p24 = bind(p23^, Add())
    var p25 = bind(p24^, Add())
    var p26 = bind(p25^, Add())
    var p27 = bind(p26^, Add())
    var p28 = bind(p27^, Add())
    var p29 = bind(p28^, Add())
    var p30 = bind(p29^, Add())
    var p31 = bind(p30^, Add())
    var p32 = bind(p31^, Add())
    var p33 = bind(p32^, Add())
    var p34 = bind(p33^, Add())
    var p35 = bind(p34^, Add())
    var p36 = bind(p35^, Add())
    var p37 = bind(p36^, Add())
    var p38 = bind(p37^, Add())
    var p39 = bind(p38^, Add())
    var p40 = bind(p39^, Add())
    var p41 = bind(p40^, Add())
    var p42 = bind(p41^, Add())
    var p43 = bind(p42^, Add())
    var p44 = bind(p43^, Add())
    var p45 = bind(p44^, Add())
    var p46 = bind(p45^, Add())
    var p47 = bind(p46^, Add())
    var p48 = bind(p47^, Add())
    var p49 = bind(p48^, Add())
    var p50 = bind(p49^, Add())
    var p51 = bind(p50^, Add())
    var p52 = bind(p51^, Add())
    var p53 = bind(p52^, Add())
    var p54 = bind(p53^, Add())
    var p55 = bind(p54^, Add())
    var p56 = bind(p55^, Add())
    var p57 = bind(p56^, Add())
    var p58 = bind(p57^, Add())
    var p59 = bind(p58^, Add())
    var p60 = bind(p59^, Add())
    var p61 = bind(p60^, Add())
    var p62 = bind(p61^, Add())
    var p63 = bind(p62^, Add())
    var p64 = bind(p63^, Add())
    var outcome = run(p64^)
    check(outcome.take()._take_ok() == 64, "64 nested binds")
    print("depth: 64 nested binds")
