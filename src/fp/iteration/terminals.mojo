"""Consuming searches, counts, sinks and optional aggregation."""
from std.builtin.rebind import downcast
from fp.callables.protocols import UnaryContract, BorrowCallContract, BorrowCallable
from fp.callables.invoke import RepeatableBorrow
from fp.callables._views import _UnaryViewable, _BorrowViewable
from fp.callables.native import _Unary, _RaisingUnary, _NativeUnaryRef, _Borrowing, _RaisingBorrowing, _NativeBorrowRef
from fp.callables._transforms import _BorrowedUnary
from fp.callables._identity import Identity
from fp.data.non_empty_list import NonEmptyList
from fp.algebra.protocols import Semigroup, Monoid, _Accumulate, _map_accumulate, _start_as
from fp.algebra._traversal import _Discard
from fp._internal.errors import _CommonError, _ErrorCompatible
from ._advance import _Source, _source
from .adapters import collect_list, any as _any
from fp.algebra._accumulation import _Combine, _OptionalCombine


struct _Count[T: Movable & Deinitable](_Accumulate):
    comptime Acc = Int
    comptime Item = Self.T
    @staticmethod
    def start() -> Int: return 0
    @staticmethod
    def live(ref acc: Int) -> Bool: return True
    @staticmethod
    def combine(var acc: Int, var item: Self.T) -> Int: return acc + 1


struct _CountAccepted(_Accumulate):
    comptime Acc = Int
    comptime Item = Bool
    @staticmethod
    def start() -> Int: return 0
    @staticmethod
    def live(ref acc: Int) -> Bool: return True
    @staticmethod
    def combine(var acc: Int, var item: Bool) -> Int: return acc + Int(item)


struct _Last[T: Movable & Deinitable](_Accumulate):
    comptime Acc = Optional[Self.T]
    comptime Item = Self.T
    @staticmethod
    def start() -> Self.Acc: return None
    @staticmethod
    def live(ref acc: Self.Acc) -> Bool: return True
    @staticmethod
    def combine(var acc: Self.Acc, var item: Self.T) -> Self.Acc: return Optional(item^)


@fieldwise_init
struct _EqualTo[T: Equatable & Movable & Deinitable, o: ImmOrigin](BorrowCallable):
    comptime Payload = Self.T
    comptime Result = Bool
    var value: Pointer[Self.T, Self.o]
    def invoke(self, ref payload: Self.T) capturing -> Bool:
        return payload == self.value[]


struct _CollectFold[M: Monoid](_Accumulate):
    comptime Acc = Self.M.Value
    comptime Item = Optional[Self.M.Value]
    comptime Error = Self.M.Error
    @staticmethod
    def start() raises Self.Error -> Self.Acc: return _Combine[Self.M].start()
    @staticmethod
    def live(ref acc: Self.Acc) -> Bool: return True
    @staticmethod
    def combine(var acc: Self.Acc, var item: Self.Item) raises Self.Error -> Self.Acc:
        if not item: return acc^
        return _Combine[Self.M].combine(acc^, item.unsafe_take())


def _count_where[C: BorrowCallContract & Movable & Deinitable, V: Movable & Deinitable](var predicate: C, var source: V) raises C.Failure -> Int where RepeatableBorrow[C]:
    comptime T = downcast[C.Payload, Movable & Deinitable]
    comptime assert C.Result == Bool and _Source[V].Element == T
    return _map_accumulate[_Source[V], _BorrowedUnary[T, C], _CountAccepted, C.Failure](
        _BorrowedUnary[T, C](predicate^), _source(source^), 0)


def _for_each[F: UnaryContract & Movable & Deinitable, V: Movable & Deinitable](var function: F, var source: V) raises F.Error -> NoneType:
    comptime assert F.Out == NoneType and _Source[V].Element == F.Arg
    return _map_accumulate[_Source[V], F, _Discard[NoneType], F.Error](function^, _source(source^), None)


def _collect_fold[M: Monoid, F: UnaryContract & Movable & Deinitable, V: Movable & Deinitable, E: Movable & Deinitable = _CommonError[F.Error, M.Error]](var function: F, var source: V) raises E -> M.Value:
    comptime assert F.Out == Optional[M.Value] and _Source[V].Element == F.Arg
    comptime assert _ErrorCompatible[E, M.Error] and _ErrorCompatible[E, F.Error], "collect_fold: callback and monoid error types must match"
    return _map_accumulate[_Source[V], F, _CollectFold[M], E](function^, _source(source^), _start_as[E, _CollectFold[M]]())

