def first[V: Movable & Deinitable](var source: V) -> Optional[downcast[_Source[V].Element, Movable & Deinitable]] where conforms_to(_Source[V].Element, Deinitable):
    """Consume at most one element and return it, or None for empty input.

    The source is consumed without restarting. Values are moved or destroyed
    without requiring copies. Early exit destroys the unconsumed owner; no
    additional value is pulled. Collection and full reductions require finite
    input; count visits every element even when bounds give its length.

    Parameters:
        V: The consumed native iterator or owned collection type.

    Args:
        source: The source, consumed at its current position.

    Returns:
        Optional[downcast[_Source[V].Element, Movable & Deinitable]] with the ownership, timing and empty-input behavior described above.
    """
    return _source(source^).nth(0)

def last[V: Movable & Deinitable](var source: V) -> Optional[downcast[_Source[V].Element, Movable & Deinitable]] where conforms_to(_Source[V].Element, Deinitable):
    """Consume every remaining element and return the last, or None.

    The source is consumed without restarting. Values are moved or destroyed
    without requiring copies. Early exit destroys the unconsumed owner; no
    additional value is pulled. Collection and full reductions require finite
    input; count visits every element even when bounds give its length.

    Parameters:
        V: The consumed native iterator or owned collection type.

    Args:
        source: The source, consumed at its current position.

    Returns:
        Optional[downcast[_Source[V].Element, Movable & Deinitable]] with the ownership, timing and empty-input behavior described above.
    """
    return _map_accumulate[_Source[V], Identity[downcast[_Source[V].Element, Movable & Deinitable]], _Last[downcast[_Source[V].Element, Movable & Deinitable]], Never](Identity[downcast[_Source[V].Element, Movable & Deinitable]](), _source(source^), Optional[downcast[_Source[V].Element, Movable & Deinitable]]())

def is_empty[V: Movable & Deinitable](var source: V) -> Bool where conforms_to(_Source[V].Element, Deinitable):
    """Consume at most one element and report whether none was present.

    The source is consumed without restarting. Values are moved or destroyed
    without requiring copies. Early exit destroys the unconsumed owner; no
    additional value is pulled. Collection and full reductions require finite
    input; count visits every element even when bounds give its length.

    Parameters:
        V: The consumed native iterator or owned collection type.

    Args:
        source: The source, consumed at its current position.

    Returns:
        Bool with the ownership, timing and empty-input behavior described above.
    """
    return not first(source^)

def count[V: Movable & Deinitable](var source: V) -> Int where conforms_to(_Source[V].Element, Deinitable):
    """Consume and count every remaining element; empty input returns zero.

    The source is consumed without restarting. Values are moved or destroyed
    without requiring copies. Early exit destroys the unconsumed owner; no
    additional value is pulled. Collection and full reductions require finite
    input; count visits every element even when bounds give its length.

    Parameters:
        V: The consumed native iterator or owned collection type.

    Args:
        source: The source, consumed at its current position.

    Returns:
        Int with the ownership, timing and empty-input behavior described above.
    """
    return _map_accumulate[_Source[V], Identity[downcast[_Source[V].Element, Movable & Deinitable]], _Count[downcast[_Source[V].Element, Movable & Deinitable]], Never](Identity[downcast[_Source[V].Element, Movable & Deinitable]](), _source(source^), 0)

def contains[T: Equatable & Movable & Deinitable, o: ImmOrigin, V: Movable & Deinitable](var source: V, ref[o] value: T) -> Bool where _Source[V].Element == T and conforms_to(_Source[V].Element, Movable & Deinitable):
    """Borrow candidates for native equality and stop at the first match.

    The source is consumed without restarting. Values are moved or destroyed
    without requiring copies. Early exit destroys the unconsumed owner; no
    additional value is pulled. Collection and full reductions require finite
    input; count visits every element even when bounds give its length.

    Parameters:
        T: The source element type, including origins.
        o: The origin of the borrowed callback or comparison value.
        V: The consumed native iterator or owned collection type.

    Args:
        source: The source, consumed at its current position.
        value: The comparison value, borrowed for the duration of the terminal.

    Returns:
        Bool with the ownership, timing and empty-input behavior described above.
    """
    return _any(source^, _EqualTo[T, o](Pointer(to=value)))

def to_non_empty_list[V: Movable & Deinitable](var source: V) -> Optional[NonEmptyList[downcast[_Source[V].Element, Movable & Deinitable]]] where conforms_to(_Source[V].Element, Deinitable):
    """Collect once into a checked NonEmptyList, returning None when empty.

    The source is consumed without restarting. Values are moved or destroyed
    without requiring copies. Early exit destroys the unconsumed owner; no
    additional value is pulled. Collection and full reductions require finite
    input; count visits every element even when bounds give its length.

    Parameters:
        V: The consumed native iterator or owned collection type.

    Args:
        source: The source, consumed at its current position.

    Returns:
        Optional[NonEmptyList[downcast[_Source[V].Element, Movable & Deinitable]]] with the ownership, timing and empty-input behavior described above.
    """
    return NonEmptyList[downcast[_Source[V].Element, Movable & Deinitable]].from_list(collect_list[T=downcast[_Source[V].Element, Movable & Deinitable]](source^))

def combine_all_optional[S: Semigroup, V: Movable & Deinitable](var source: V) raises S.Error -> Optional[S.Value] where _Source[V].Element == S.Value:
    """Combine left to right with a Semigroup; empty input returns None.

    The source is consumed without restarting. Values are moved or destroyed
    without requiring copies. Early exit destroys the unconsumed owner; no
    additional value is pulled. Collection and full reductions require finite
    input; count visits every element even when bounds give its length.

    Parameters:
        S: The explicit Semigroup; no identity value is required.
        V: The consumed native iterator or owned collection type.

    Args:
        source: The source, consumed at its current position.

    Returns:
        Optional[S.Value] with the ownership, timing and empty-input behavior described above.

    Raises:
        The exact admitted callback or combination error; Never when non-raising.
    """
    return _map_accumulate[_Source[V], Identity[S.Value], _OptionalCombine[S], S.Error](Identity[S.Value](), _source(source^), Optional[S.Value]())

def count_where[P: AnyType, R: Movable & Deinitable, o: ImmOrigin, V: Movable & Deinitable, //, F: _Borrowing[P, R]](var source: V, ref[o] predicate: F) raises Never -> Int where _Source[V].Element == downcast[P, Movable & Deinitable] and R == Bool:
    """Count accepted candidates, borrowing each once; empty input returns zero.

    This is a consuming terminal. Native callbacks are borrowed in place;
    shared library views borrow their receiver; other library callbacks are
    consumed. Failure stops before the next pull and
    keeps its exact native type, including callback StopIteration. Move-only
    inputs and results retain their origins; no intermediate collection is built.

    Parameters:
        P: The admitted type parameter.
        R: The callback result type.
        o: The origin of the borrowed callback or comparison value.
        V: The consumed native iterator or owned collection type.
        F: The concrete callback type, preserving captures and receiver semantics.

    Args:
        source: The source, consumed at its current position.
        predicate: The predicate, borrowing each candidate; the selected overload borrows or owns the predicate.

    Returns:
        Int with the ownership, timing and empty-input behavior described above.

    Raises:
        The exact admitted callback or combination error; Never when non-raising.
    """
    return _count_where(_NativeBorrowRef[P, R, Never, F, False, o](Pointer(to=predicate)), source^)

def count_where[P: AnyType, R: Movable & Deinitable, o: ImmOrigin, V: Movable & Deinitable, //, E: Movable & Deinitable, F: _RaisingBorrowing[P, R, E]](var source: V, ref[o] predicate: F) raises E -> Int where _Source[V].Element == downcast[P, Movable & Deinitable] and R == Bool:
    """Count accepted candidates, borrowing each once; empty input returns zero.
    """
    return _count_where(_NativeBorrowRef[P, R, E, F, True, o](Pointer(to=predicate)), source^)

def count_where[C: BorrowCallContract & Movable & Deinitable, V: Movable & Deinitable](var source: V, var predicate: C) raises C.Failure -> Int where _Source[V].Element == downcast[C.Payload, Movable & Deinitable] and C.Result == Bool and RepeatableBorrow[C]:
    """Count accepted candidates, borrowing each once; empty input returns zero.
    """
    return _count_where(predicate^, source^)

def count_where[C: _BorrowViewable, o: ImmOrigin, V: Movable & Deinitable](var source: V, ref[o] predicate: C) raises C._BorrowView[o].Failure -> Int where _Source[V].Element == downcast[C._BorrowView[o].Payload, Movable & Deinitable] and C._BorrowView[o].Result == Bool:
    """Count accepted candidates, borrowing each once; empty input returns zero.
    """
    return _count_where(predicate._borrow_view(), source^)

def for_each[A: Movable & Deinitable, R: Movable & Deinitable, o: ImmOrigin, V: Movable & Deinitable, //, F: _Unary[A, R]](var source: V, ref[o] function: F) raises Never -> NoneType where _Source[V].Element == A and R == NoneType:
    """Move each element into a callback returning NoneType, then return None.

    This is a consuming terminal. Native callbacks are borrowed in place;
    shared library views borrow their receiver; other library callbacks are
    consumed. Failure stops before the next pull and
    keeps its exact native type, including callback StopIteration. Move-only
    inputs and results retain their origins; no intermediate collection is built.

    Parameters:
        A: The first callback argument type.
        R: The callback result type.
        o: The origin of the borrowed callback or comparison value.
        V: The consumed native iterator or owned collection type.
        F: The concrete callback type, preserving captures and receiver semantics.

    Args:
        source: The source, consumed at its current position.
        function: The callback, borrowed or owned according to the selected overload; captures retain their native origins.

    Returns:
        NoneType with the ownership, timing and empty-input behavior described above.

    Raises:
        The exact admitted callback or combination error; Never when non-raising.
    """
    return _for_each(_NativeUnaryRef[A, R, Never, F, False, o](Pointer(to=function)), source^)

def for_each[A: Movable & Deinitable, R: Movable & Deinitable, o: ImmOrigin, V: Movable & Deinitable, //, E: Movable & Deinitable, F: _RaisingUnary[A, R, E]](var source: V, ref[o] function: F) raises E -> NoneType where _Source[V].Element == A and R == NoneType:
    """Move each element into a callback returning NoneType, then return None.
