"""Position-wise alignment through the leaf Ior carrier and the shared map driver."""
from std.iter import Iterator, IterableOwned
from std.builtin.rebind import downcast
from fp.data.ior import Ior, _ior_parts, _ior_from_parts
from fp.callables.protocols import Unary, UnaryContract
from fp.callables.invoke import RepeatableUnary
from ._advance import _Source, _source, _next_optional_fused
from ._callbacks import _LazyUnary
from .adapters import _Map


@fieldwise_init
struct _Align[A: Movable & Deinitable, B: Movable & Deinitable, I: Iterator, J: Iterator](Iterator, IterableOwned):
    comptime Element = Ior[Self.A, Self.B]
    comptime IteratorOwnedType = Self
    var left: Self.I
    var right: Self.J
    var left_done: Bool
    var right_done: Bool
    def __iter__(var self) -> Self: return self^
    def __next__(mut self) raises StopIteration -> Self.Element:
        comptime assert Self.I.Element == Self.A and Self.J.Element == Self.B
        var left = _next_optional_fused[Self.A](self.left, self.left_done)
        var right = _next_optional_fused[Self.B](self.right, self.right_done)
        if not left and not right: raise StopIteration()
        return _ior_from_parts(left^, right^)
    def bounds(self) -> Tuple[Int, Optional[Int]]:
        var left = (0, Optional(0)) if self.left_done else self.left.bounds()
        var right = (0, Optional(0)) if self.right_done else self.right.bounds()
        var upper = Optional[Int]()
        if left[1] and right[1]: upper = Optional(max(left[1].value(), right[1].value()))
        return (max(left[0],right[0]), upper^)


@fieldwise_init
struct _Pad[A: Movable & Deinitable, B: Movable & Deinitable](Unary):
    comptime Arg = Ior[Self.A, Self.B]
    comptime Out = Tuple[Optional[Self.A], Optional[Self.B]]
    def call(self, var arg: Self.Arg) -> Self.Out:
        var left = Optional[Self.A]()
        var right = Optional[Self.B]()
        _ior_parts(arg^).split(left, right)
        return (left^, right^)


comptime AlignIterator[A: Movable & Deinitable, B: Movable & Deinitable, I: Iterator, J: Iterator] = _Align[A,B,I,J]
"""A fused iterator of Ior values, continuing until both sources end.

Parameters:
    A: The left source element type, including origins.
    B: The right source element type, including origins.
    I: The normalized left iterator type.
    J: The normalized right iterator type.
"""

comptime AlignWithIterator[A: Movable & Deinitable, B: Movable & Deinitable, U: Movable & Deinitable, I: Iterator, J: Iterator, F: Movable & Deinitable] = _Map[Ior[A,B],U,_Align[A,B,I,J],F]
"""The map of alignment, retaining both source types and the owned callback.

Parameters:
    A: The left source element type.
    B: The right source element type.
    U: The callback result type.
    I: The normalized left iterator type.
    J: The normalized right iterator type.
    F: The concrete non-raising callback, including captures and origins.
"""

comptime PadZipIterator[A: Movable & Deinitable, B: Movable & Deinitable, I: Iterator, J: Iterator] = _Map[Ior[A,B],Tuple[Optional[A],Optional[B]],_Align[A,B,I,J],_Pad[A,B]]
"""Alignment mapped to native optional pairs; at least one field is present.

Parameters:
    A: The left source element type.
    B: The right source element type.
    I: The normalized left iterator type.
    J: The normalized right iterator type.
"""

