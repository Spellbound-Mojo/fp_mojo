"""Lazy prefix adapters with retained, non-raising runtime predicates."""
from std.iter import Iterator, IterableOwned
from std.builtin.rebind import downcast, rebind_var
from fp.callables.protocols import BorrowCallable, BorrowCallContract
from fp.callables.invoke import RepeatableBorrow
from fp.callables._views import _BorrowViewable
from fp.callables.products import _OptionalCell
from ._advance import _Source, _source, _next_fused
from ._callbacks import _LazyPredicate, _apply_lazy_predicate


@fieldwise_init
struct _Prefix[T: Movable & Deinitable, I: Iterator, F: Movable & Deinitable,
               taking: Bool](Iterator, IterableOwned):
    comptime Element = Self.T
    comptime IteratorOwnedType = Self
    var _function: _OptionalCell[Self.F]
    var source: Self.I
    var prefix: Bool
    var done: Bool
    def __init__(out self, var function: Self.F, var source: Self.I, prefix: Bool, done: Bool):
        self._function = Optional(function^)
        self.source = source^
        self.prefix = prefix
        self.done = done

    def __iter__(var self) -> Self:
        return self^
    def __next__(mut self) raises StopIteration -> Self.T:
        comptime assert Self.I.Element == Self.T
        while True:
            var item = _next_fused(self.source, self.done)
            var value = rebind_var[Self.T](item^)
            if not self.prefix:
                return value^
            var accepted = _apply_lazy_predicate[Self.T, Self.F](self._function.value(), value)
            comptime if Self.taking:
                if accepted:
                    return value^
                self.done = True
                raise StopIteration()
            else:
                if not accepted:
                    self.prefix = False
                    return value^
    def bounds(self) -> Tuple[Int, Optional[Int]]:
        if self.done: return (0, Optional(0))
        var lower, upper = self.source.bounds()
        return (lower if not self.prefix else 0, upper^)


comptime TakeWhileIterator[T: Movable & Deinitable, I: Iterator, F: Movable & Deinitable = def(T) thin -> Bool] = _Prefix[T, I, F, True]
"""A fused taking prefix with a stored predicate and the source's origins.

Parameters:
    T: The yielded element type.
    I: The normalized native iterator type.
    F: The concrete non-raising borrowed predicate type.
"""
comptime DropWhileIterator[T: Movable & Deinitable, I: Iterator, F: Movable & Deinitable = def(T) thin -> Bool] = _Prefix[T, I, F, False]
"""A fused dropping prefix; the predicate stops after the first rejection.

Parameters:
    T: The yielded element type.
    I: The normalized native iterator type.
    F: The concrete non-raising borrowed predicate type.
"""

# --- iterator expansion syntax (generated) ---
# Generated by scripts/generate_plain_overloads.py; algorithms live in the operation owners.

def take_while[T: Movable & Deinitable, V: Movable & Deinitable](var predicate: def(T) thin -> Bool, var source: V) -> TakeWhileIterator[T, _Source[V], def(T) thin -> Bool] where _Source[V].Element == T:
    """Yield the initial matching prefix; consume and discard its first rejection.

    Construction pulls nothing. The stored predicate borrows each candidate and cannot raise.
    Exhaustion is fused; abandonment releases captures and the unconsumed source.
    Uses constant state and preserves move-only elements and embedded origins.

    Parameters:
        T: The source element type, including origins.
        V: The consumed native iterator or owned collection type.

    Args:
        predicate: The predicate, borrowing each candidate; the selected overload borrows or owns the predicate.
        source: The source, consumed at its current position.

    Returns:
        TakeWhileIterator[T, _Source[V], def(T) thin -> Bool] with the ownership, timing and empty-input behavior described above.
    """
    return _Prefix[T, _Source[V], def(T) thin -> Bool, True](predicate, _source(source^), True, False)

def take_while[T: Movable & Deinitable, V: Movable & Deinitable, //, F: _LazyPredicate[T]](var predicate: F, var source: V) -> TakeWhileIterator[T, _Source[V], F] where _Source[V].Element == T:
    """Yield the initial matching prefix; consume and discard its first rejection.
    """
    return _Prefix[T, _Source[V], F, True](predicate^, _source(source^), True, False)

