def scan_map[A: Movable & Deinitable, T: Movable & Deinitable, Y: Movable & Deinitable, F: _BinaryViewable, o: ImmOrigin, V: Movable & Deinitable](var source: V, var initial: A, ref[o] function: F) -> ScanMapIterator[A, T, Y, _Source[V], _SharedBinaryRef[F, o]] where _Source[V].Element == T and _SharedBinaryRef[F, o].First == A and _SharedBinaryRef[F, o].Second == T and _SharedBinaryRef[F, o].Out == Tuple[A, Y] and _SharedBinaryRef[F, o].Error == Never and RepeatableBinary[_SharedBinaryRef[F, o]]:
