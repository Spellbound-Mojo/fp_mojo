    """Lazily consume (carry, input) into (new carry, output), yielding one output per input.
    """
    return ScanMapIterator[A, T, Y, _Source[V], F](function^, initial^, _source(source^), False, False)

def scan_map[A: Movable & Deinitable, T: Movable & Deinitable, Y: Movable & Deinitable, F: BinaryContract & Movable & Deinitable, V: Movable & Deinitable](var function: F, var initial: A, var source: V) -> ScanMapIterator[A, T, Y, _Source[V], F] where _Source[V].Element == T and F.First == A and F.Second == T and F.Out == Tuple[A, Y] and F.Error == Never and RepeatableBinary[F]:
