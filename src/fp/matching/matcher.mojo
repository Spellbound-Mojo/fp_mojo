"""Pattern matching on algebraic data: `match` and `rewrite`.

A match takes a value and one to sixteen clauses. A clause is a plain function or
a lambda without captures; its parameter type selects the constructor it handles
and says, field by field, whether a recursive field arrives as it is or already
matched. The library checks the clauses when the program compiles and runs the
match as one loop over an explicit stack, so a match is exhaustive, terminates
on any value, and is not limited by the native stack.

`match` also takes a context shared by every clause, or a tuple of two or three
subjects. `rewrite` transforms a value bottom-up with clauses for the
constructors that change.
"""
from std.os import abort
from std.builtin.rebind import downcast
from fp.adt.data import Value, Data, Node, _NodeType
from fp.matching._engine import _ClauseSet, _Cons, _Nil, _Absent, _Sig1, _Sig2, _Sig3, _Pick, _NoResult, _admit, _run
from fp.matching._inline import _Context, _admit_inline, _run_inline
from fp._internal.errors import _NativeError, _CommonError


# A clause set is a list of clauses, built from the last clause to the first.
# Each arity has its own name: nested calls to an overloaded function are
# resolved by backtracking, which takes time exponential in the clause count.

def _push1[A: AnyType, O: Value, E: AnyType, Rest: _ClauseSet](
    clause: def(A) raises E thin -> O, var rest: Rest
) -> _Cons[_Sig1[A, O, _NativeError[E]], Rest]:
    comptime S = _Sig1[A, O, _NativeError[E]]
    return _Cons[S, Rest](rebind[S.Fn](clause), rest^)


def _push2[A: AnyType, B: AnyType, O: Value, E: AnyType, Rest: _ClauseSet](
    clause: def(A, B) raises E thin -> O, var rest: Rest
) -> _Cons[_Sig2[A, B, O, _NativeError[E]], Rest]:
    comptime S = _Sig2[A, B, O, _NativeError[E]]
    return _Cons[S, Rest](rebind[S.Fn](clause), rest^)


def _push3[A: AnyType, B: AnyType, C: AnyType, O: Value, E: AnyType, Rest: _ClauseSet](
    clause: def(A, B, C) raises E thin -> O, var rest: Rest
) -> _Cons[_Sig3[A, B, C, O, _NativeError[E]], Rest]:
    comptime S = _Sig3[A, B, C, O, _NativeError[E]]
    return _Cons[S, Rest](rebind[S.Fn](clause), rest^)


# Each entry checks the clauses first and compiles the run only when they are
# admitted, so a rejected match reports the admission message alone. The result
# and error types come from the generated signature, which spells them over the
# clause types directly: deriving them from the clause set instead takes the
# compiler time exponential in the clause count.

def _match[S: AnyType, C: _ClauseSet, X: AnyType, //, R: Value, E: Value](
    subject: S, clauses: C, context: X
) raises E -> R:
    """A `Node` is matched by the recursive engine; any other subject by the inline one."""
    comptime if conforms_to(S, _NodeType):
        comptime F = downcast[S, _NodeType].Of
        comptime admitted = _admit[F, C, R, E, X, False]()
        comptime if admitted:
            return _run[F, C, R, E, X, False](rebind[Node[F]](subject), clauses, context)
        else:
            abort("fp.match: the clauses were not admitted")
    elif X == _Absent:
        return _match_all[R, E](subject, _Absent(), _Absent(), clauses)
    else:
        return _match_all[R, E](subject, _Context[X](context), _Absent(), clauses)


def _rewrite[F: Data, C: _ClauseSet, //, E: Value](subject: Node[F], clauses: C) raises E -> Node[F]:
    comptime admitted = _admit[F, C, Node[F], E, _Absent, True]()
    comptime if admitted:
        return _run[F, C, Node[F], E, _Absent, True](subject, clauses, _Absent())
    else:
        abort("fp.rewrite: the clauses were not admitted")


def _match_all[C: _ClauseSet, S0: AnyType, S1: AnyType, S2: AnyType, //, R: Value, E: Value](
    a: S0, b: S1, c: S2, clauses: C
) raises E -> R:
    comptime admitted = _admit_inline[C, R, E, S0, S1, S2]()
    comptime if admitted:
        return _run_inline[C, R, E, S0, S1, S2](a, b, c, clauses)
    else:
        abort("fp.match: the clauses were not admitted")


# --- match overloads (generated) ---
# Generated by scripts/generate_plain_overloads.py; edit the generator, not this
# block. A clause's signature is known only at a parameter of its function type,
# so each clause count spells one thin signature per clause. A clause's error is
# inferred as AnyType: under a value bound a pure function's error is not Never
# (see _NativeError). _Result<n> and _Error<n> spell the match's types over the
# clause types (see _match). The one-clause overload of each form carries the
# documentation.

comptime _Result1[O0: Value]: Value = _Pick[O0, _NoResult]
comptime _Error1[E0: AnyType]: Value = _CommonError[_NativeError[E0], Never]
comptime _Result2[O0: Value, O1: Value]: Value = _Pick[O0, _Pick[O1, _NoResult]]
comptime _Error2[E0: AnyType, E1: AnyType]: Value = _CommonError[_NativeError[E0], _CommonError[_NativeError[E1], Never]]
