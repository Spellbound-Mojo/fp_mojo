def `match`[
    S: AnyType,
    A0: AnyType, O0: Value, E0: AnyType,
    //
](
    subject: S,
    f0: def(A0) raises E0 thin -> O0
) raises _Error1[E0] -> _Result1[O0]:
    """Match `subject` with clauses: the first that applies to it gives the result.

    Takes one to sixteen clauses. A clause is a plain function or a lambda without
    captures; its parameter type says which values it applies to, and a `when`
    clause may decline. The clauses are checked when the program compiles. The
    subject is one of:

    - a `Node[F]`: a clause takes a constructor of `F`, whose recursive fields are
      declared either as stored, `Node[F]`, or as the result type, in which case
      they arrive already matched; or it takes `Node[F]`, which accepts any
      constructor. A clause returns the result or `Next(node)`, to continue with a
      smaller value.
    - a value stored in place, such as `Choice[F]` or `Result[T, E]`: a clause
      takes a constructor, or the whole type.
    - an `Optional[T]`: a clause takes `T` for a present value, `NoneType` for an
      absent one, or `Optional[T]`.

    Parameters:
        S: The subject's type.
        A0: The clause's parameter type.
        O0: The clause's result type: the result, `Next[Node[F]]`, or a guarded result.
        E0: The clause's error type, `Never` for a pure clause.

    Args:
        subject: The value to match, borrowed.
        f0: The first clause; further clauses follow in order.

    Returns:
        The result of the first clause that applies.

    Raises:
        The clauses' common error; a match of pure clauses does not raise.
    """
    return _match[_Result1[O0], _Error1[E0]](subject, _push1(f0, _Nil()), _Absent())


def `match`[
    S: AnyType,
    A0: AnyType, O0: Value, E0: AnyType,
    A1: AnyType, O1: Value, E1: AnyType,
    //
](
    subject: S,
    f0: def(A0) raises E0 thin -> O0,
    f1: def(A1) raises E1 thin -> O1
) raises _Error2[E0, E1] -> _Result2[O0, O1]:
    """Match `subject` with 2 clauses."""
    return _match[_Result2[O0, O1], _Error2[E0, E1]](subject, _push1(f0, _push1(f1, _Nil())), _Absent())


def `match`[
    S: AnyType,
    A0: AnyType, O0: Value, E0: AnyType,
    A1: AnyType, O1: Value, E1: AnyType,
    A2: AnyType, O2: Value, E2: AnyType,
    //
](
    subject: S,
    f0: def(A0) raises E0 thin -> O0,
    f1: def(A1) raises E1 thin -> O1,
    f2: def(A2) raises E2 thin -> O2
) raises _Error3[E0, E1, E2] -> _Result3[O0, O1, O2]:
    """Match `subject` with 3 clauses."""
    return _match[_Result3[O0, O1, O2], _Error3[E0, E1, E2]](subject, _push1(f0, _push1(f1, _push1(f2, _Nil()))), _Absent())


def `match`[
    S: AnyType,
    A0: AnyType, O0: Value, E0: AnyType,
    A1: AnyType, O1: Value, E1: AnyType,
    A2: AnyType, O2: Value, E2: AnyType,
    A3: AnyType, O3: Value, E3: AnyType,
    //
](
    subject: S,
    f0: def(A0) raises E0 thin -> O0,
    f1: def(A1) raises E1 thin -> O1,
    f2: def(A2) raises E2 thin -> O2,
    f3: def(A3) raises E3 thin -> O3
) raises _Error4[E0, E1, E2, E3] -> _Result4[O0, O1, O2, O3]:
    """Match `subject` with 4 clauses."""
    return _match[_Result4[O0, O1, O2, O3], _Error4[E0, E1, E2, E3]](subject, _push1(f0, _push1(f1, _push1(f2, _push1(f3, _Nil())))), _Absent())


def `match`[
    S: AnyType,
    A0: AnyType, O0: Value, E0: AnyType,
    A1: AnyType, O1: Value, E1: AnyType,
    A2: AnyType, O2: Value, E2: AnyType,
    A3: AnyType, O3: Value, E3: AnyType,
    A4: AnyType, O4: Value, E4: AnyType,
    //
](
    subject: S,
    f0: def(A0) raises E0 thin -> O0,
    f1: def(A1) raises E1 thin -> O1,
    f2: def(A2) raises E2 thin -> O2,
    f3: def(A3) raises E3 thin -> O3,
    f4: def(A4) raises E4 thin -> O4
) raises _Error5[E0, E1, E2, E3, E4] -> _Result5[O0, O1, O2, O3, O4]:
    """Match `subject` with 5 clauses."""
    return _match[_Result5[O0, O1, O2, O3, O4], _Error5[E0, E1, E2, E3, E4]](subject, _push1(f0, _push1(f1, _push1(f2, _push1(f3, _push1(f4, _Nil()))))), _Absent())


def `match`[
    S: AnyType,
    A0: AnyType, O0: Value, E0: AnyType,
    A1: AnyType, O1: Value, E1: AnyType,
    A2: AnyType, O2: Value, E2: AnyType,
    A3: AnyType, O3: Value, E3: AnyType,
    A4: AnyType, O4: Value, E4: AnyType,
    A5: AnyType, O5: Value, E5: AnyType,
    //
](
    subject: S,
    f0: def(A0) raises E0 thin -> O0,
    f1: def(A1) raises E1 thin -> O1,
    f2: def(A2) raises E2 thin -> O2,
    f3: def(A3) raises E3 thin -> O3,
    f4: def(A4) raises E4 thin -> O4,
    f5: def(A5) raises E5 thin -> O5
) raises _Error6[E0, E1, E2, E3, E4, E5] -> _Result6[O0, O1, O2, O3, O4, O5]:
    """Match `subject` with 6 clauses."""
    return _match[_Result6[O0, O1, O2, O3, O4, O5], _Error6[E0, E1, E2, E3, E4, E5]](subject, _push1(f0, _push1(f1, _push1(f2, _push1(f3, _push1(f4, _push1(f5, _Nil())))))), _Absent())


def `match`[
    S: AnyType,
    A0: AnyType, O0: Value, E0: AnyType,
    A1: AnyType, O1: Value, E1: AnyType,
    A2: AnyType, O2: Value, E2: AnyType,
    A3: AnyType, O3: Value, E3: AnyType,
    A4: AnyType, O4: Value, E4: AnyType,
    A5: AnyType, O5: Value, E5: AnyType,
    A6: AnyType, O6: Value, E6: AnyType,
    //
](
    subject: S,
    f0: def(A0) raises E0 thin -> O0,
    f1: def(A1) raises E1 thin -> O1,
    f2: def(A2) raises E2 thin -> O2,
    f3: def(A3) raises E3 thin -> O3,
    f4: def(A4) raises E4 thin -> O4,
