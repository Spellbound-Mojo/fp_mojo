"""Argument-first native capture admission, generated by scripts/generate_capture.py.

Select native errors and bind argument conventions before admitting a callback.
Borrowed slots retain their origins; consumed slots and keyword packs are owned.
Native run admission inlines to retain closure storage across generic forwards
at O0 on Mojo 1.2; callers need no annotation. Each _invoke consumes its receiver,
so partially transferred fields are cleaned
up exactly once if the native call raises. No allocation or type erasure is added.
"""
from std.builtin.rebind import rebind, rebind_var, downcast
from std.collections import StringDict
from fp.callables.protocols import OnceThunk
from fp.callables._binding import _BoundThunk
from fp.callables.native import (_NativeOwnedArg, _call_native_binary, _call_native, _call_native_borrow, _call_native_thunk, _call_native_keywords, _NativeMutatingRef, _NativeMutOwnedRef, _NativeMutatingKeywordsRef, _NativeMutOwnedKeywordsRef)
from fp.data._result import Result, attempt_once
from fp._internal.errors import _ErrorCompatible

from fp.callables.products import _OptionalCell

@fieldwise_init
struct _ArgsZ[E: Movable & Deinitable](Movable):
    def _run[R: Movable & Deinitable, X: Movable & Deinitable, F: Movable & Deinitable, raising: Bool, q: ImmOrigin](deinit self, ref[q] function: F) -> Result[R, X]:
        var arguments = _ArgsZ[X]()
        return attempt_once(_BoundThunk[type_of(arguments), R, X, F, q, _invoke_Z[R, X, F, raising]](arguments^, Pointer(to=function)))

    @always_inline
    def run[R: Movable & Deinitable, q: ImmOrigin, //, F: def() -> R](deinit self, ref[q] function: F) -> Result[R, Never]:
        return self^._run[R, Never, type_of(function), False](function)

    @always_inline
    def run[R: Movable & Deinitable, q: ImmOrigin, //, F: def() raises Self.E -> R](deinit self, ref[q] function: F) -> Result[R, Self.E]:
        return self^._run[R, Self.E, type_of(function), True](function)

    @always_inline
    def run[q: ImmOrigin, //, F: def()](deinit self, ref[q] function: F) -> Result[type_of(None), Never]:
        return self^._run[type_of(None), Never, type_of(function), False](function)

    @always_inline
    def run[q: ImmOrigin, //, F: def() raises Self.E](deinit self, ref[q] function: F) -> Result[type_of(None), Self.E]:
        return self^._run[type_of(None), Self.E, type_of(function), True](function)

    @always_inline
    def run[R: Movable & Deinitable, q: ImmOrigin, //, F: def() raises Never -> R](deinit self, ref[q] function: F) -> Result[R, Never] where Self.E != Never:
        return self^._run[R, Never, type_of(function), True](function)

    @always_inline
    def run[q: ImmOrigin, //, F: def() raises Never](deinit self, ref[q] function: F) -> Result[type_of(None), Never] where Self.E != Never:
        return self^._run[type_of(None), Never, type_of(function), True](function)

    @always_inline
    def run[R: Movable & Deinitable, //](deinit self, function: def() thin -> R) -> Result[R, Never] where not conforms_to(R, RegisterPassable):
        return self^._run[R, Never, type_of(function), False](function)

    @always_inline
    def run[R: RegisterPassable & Deinitable, //](deinit self, function: def() thin -> R) -> Result[R, Never]:
        return self^._run[R, Never, type_of(function), False](function)

    def run(deinit self, function: def() thin) -> Result[type_of(None), Never]:
        return self^._run[type_of(None), Never, type_of(function), False](function)

    @always_inline
    def run[R: Movable & Deinitable, X: Movable & Deinitable, //](deinit self, function: def() raises X thin -> R) -> Result[R, X] where not conforms_to(R, RegisterPassable) and _ErrorCompatible[Self.E, X]:
        return self^._run[R, X, type_of(function), True](function)

    @always_inline
    def run[R: RegisterPassable & Deinitable, X: Movable & Deinitable, //](deinit self, function: def() raises X thin -> R) -> Result[R, X] where _ErrorCompatible[Self.E, X]:
        return self^._run[R, X, type_of(function), True](function)

    @always_inline
    def run[X: Movable & Deinitable, //](deinit self, function: def() raises X thin) -> Result[type_of(None), X] where _ErrorCompatible[Self.E, X]:
        return self^._run[type_of(None), X, type_of(function), True](function)

    @always_inline
    def run[R: Movable & Deinitable, //](deinit self, function: def() raises Never thin -> R) -> Result[R, Never] where not conforms_to(R, RegisterPassable):
        return self^._run[R, Never, type_of(function), True](function)

    @always_inline
    def run[R: RegisterPassable & Deinitable, //](deinit self, function: def() raises Never thin -> R) -> Result[R, Never]:
        return self^._run[R, Never, type_of(function), True](function)

    def run(deinit self, function: def() raises Never thin) -> Result[type_of(None), Never]:
        return self^._run[type_of(None), Never, type_of(function), True](function)

    def kwargs[K: Movable & Deinitable, //](deinit self, /, var **values: K) -> _ArgsK[K, Self.E]:
        return _ArgsK[K, Self.E](values^)

    def borrow[A: Movable & Deinitable, a: ImmOrigin, //](deinit self, ref[a] value: A) -> _ArgsR[A, a, Self.E]:
        return _ArgsR[A, a, Self.E](Pointer(to=value))

    def mutable[A: Movable & Deinitable, a: MutOrigin, //](deinit self, ref[a] value: A) -> _ArgsM[A, a, Self.E]:
        return _ArgsM[A, a, Self.E](Pointer(to=value))

    def take[A: Movable & Deinitable, //](deinit self, var value: A) -> _ArgsO[A, Self.E]:
        return _ArgsO[A, Self.E](value^)

    def _invoke[R: Movable & Deinitable, F: Movable & Deinitable, raising: Bool](deinit self, function: F) raises Self.E -> R:
        return _call_native_thunk[R, Self.E, F, raising](function)

def _invoke_Z[R: Movable & Deinitable, E: Movable & Deinitable, F: Movable & Deinitable, raising: Bool](function: F, var arguments: _ArgsZ[E]) raises E -> R:
    return arguments^._invoke[R, F, raising](function)

@fieldwise_init
struct _ArgsK[K: Movable & Deinitable, E: Movable & Deinitable](Movable):
    var options: StringDict[Self.K]
