"""Select family and native errors before callback inference; reuse algebra execution."""
from std.builtin.rebind import downcast, rebind_var
from fp._internal.errors import _CommonError
from fp.data._result import _ResultType
from fp.algebra.protocols import Functor, Filterable, Monad, FunctorFilter, Applicative, Traversable
from fp.algebra.instances import ListFamily, OptionalFamily, ResultFamily, IdentityFamily, _NativeFamily
from fp.algebra._admission import _MapCompatible, _BindCompatible, _CombineCompatible, _CollectCompatible, _CarrierCompatible
from fp.algebra._derived import _map2_as
from fp.algebra._nary import _ProductRun, _ProductTypes, _MapNTypes, _map_n_as
from fp.callables.native import _NativeUnaryRef, _NativeBorrowRef, _NativeBorrow, _NativeThunkRef, NativeUnary, _NativeBinaryRef
from fp.callables.protocols import UnaryContract, BorrowCallable, BorrowCallContract, ThunkContract, BinaryContract, Binary
from fp.callables.invoke import call_once
from fp.callables._nary import _NativeNary1, _NativeNary2, _NativeNary3, _NativeNary4, _NativeNary5, _NativeNary6, _NativeNary7, _NativeNary8
from fp.callables._transforms import _ValueThunk, _Pair
from fp.functions.composition import Identity
from fp.iteration._advance import _Source
from fp.iteration.folds import fold_left as _context_fold_left, reduce_optional as _context_reduce_optional, fold_until as _context_fold_until
from fp.data.control import ControlFlow
from fp.data._result import Result

comptime _Filtering[I: Functor] = downcast[I, Filterable]
comptime _Binding[I: Functor] = downcast[I, Monad]
comptime _Compacting[I: Functor] = downcast[I, FunctorFilter]
comptime _Combining[I: Functor] = downcast[I, Applicative]
comptime _Traversing[I: Functor] = downcast[I, Traversable]
comptime _FoldElement[V: Movable & Deinitable] = downcast[_Source[V].Element, Movable & Deinitable]
comptime _Success[V: Movable & Deinitable] = downcast[V, _ResultType].Value
comptime _Failure[V: Movable & Deinitable] = downcast[V, _ResultType].Error

@fieldwise_init
struct Pipeline[I: Functor, V: Movable & Deinitable, E: Movable & Deinitable = Never](Movable):
    """A carrier with its family and native callback error selected before inference.

    Start with `pipeline(value)` for List, Optional, Result or a bare value, or
    `pipeline[Family](value)` for an explicit Functor. Select a native error
    once with `raising[E]()`. Pure callbacks keep Never; library callbacks
    keep their declared errors. `get()` extracts the value. Map, flat_map,
    filter and filter_map delegate to the family's evaluation and ownership
    rules, including deferred execution and retained callback borrows.

    `then` consumes the whole value once. It selects the returned List,
    Optional or Result family, or Identity for other values; `then[Family]`
    selects an explicit output family. Folds consume a native source and
    select the accumulator's family by the same rule. Traversal selects its
    target effect family. Combinations retain the current Applicative family.

    Result-specific methods delegate to Result and update ResultFamily when
    the stored error type changes. Native raised errors remain raised;
    use Capture to store them. Existing Piped and piped remain available.

    Parameters:
        I: The selected carrier family.
        V: The complete carrier type, including its origins.
        E: The native callback error, selected before inference; Never by default.
    """
    var value: Self.V
    """The carrier owned by this pipeline."""

    def raising[X: Movable & Deinitable](deinit self) -> Pipeline[Self.I, Self.V, X]:
        """Select the native callback error for following stages.

        Parameters:
            X: The native error type; independent of a Result's stored error.

        Returns:
            The same carrier and family with the selected native error.
        """
        return Pipeline[Self.I, Self.V, X](self.value^)

    def get(deinit self) -> Self.V:
        """Consume the pipeline and extract its carrier without evaluating it.

        Returns:
            The carrier with its original ownership and origins.
        """
        return self.value^

    # --- selected context methods (generated) ---
    # Generated by scripts/generate_context.py; callbacks adapt signatures only.

    @always_inline
    def then[C: UnaryContract & Movable & Deinitable, //, J: Functor = _NativeFamily[C.Out]](deinit self, var function: C) raises C.Error -> Pipeline[J, C.Out, Self.E] where C.Arg == Self.V:
        """Consume the whole value with one stage and select its output family.

        Parameters:
            C: The first library callback type, retaining its receiver and origins.
            J: The output family; inferred for whole-value stages, explicit for traversal.

        Args:
            function: The callback; native callbacks are borrowed, library callbacks consumed.

        Returns:
            The pipeline containing the operation result, retaining its selected native error.

        Raises:
            The exact callback or family error; it never becomes a stored Result error.
        """
        return Pipeline[J, C.Out, Self.E](call_once(function^, rebind_var[C.Arg](self.value^)))

    @always_inline
    def then[R: Movable & Deinitable, o: ImmOrigin, C: def(var Self.V) -> R, //, J: Functor = _NativeFamily[R]](deinit self, ref[o] function: C) raises Never -> Pipeline[J, R, Self.E]:
        """Consume the whole value with one stage and select its output family."""
        return Pipeline[J, R, Self.E](call_once(_NativeUnaryRef[Self.V, R, Never, C, False, o](Pointer(to=function)), rebind_var[_NativeUnaryRef[Self.V, R, Never, C, False, o].Arg](self.value^)))

    @always_inline
    def then[R: Movable & Deinitable, //, J: Functor = _NativeFamily[R]](deinit self, function: def(var Self.V) thin -> R) raises Never -> Pipeline[J, R, Self.E]:
        """Consume the whole value with one stage and select its output family."""
        return Pipeline[J, R, Self.E](call_once(NativeUnary[Self.V, R, Never, def(var Self.V) thin -> R, False](function), rebind_var[NativeUnary[Self.V, R, Never, def(var Self.V) thin -> R, False].Arg](self.value^)))

    @always_inline
    def then[R: Movable & Deinitable, o: ImmOrigin, C: def(var Self.V) raises Self.E -> R, //, J: Functor = _NativeFamily[R]](deinit self, ref[o] function: C) raises Self.E -> Pipeline[J, R, Self.E]:
        """Consume the whole value with one stage and select its output family."""
        return Pipeline[J, R, Self.E](call_once(_NativeUnaryRef[Self.V, R, Self.E, C, True, o](Pointer(to=function)), rebind_var[_NativeUnaryRef[Self.V, R, Self.E, C, True, o].Arg](self.value^)))

    @always_inline
    def then[R: Movable & Deinitable, o: ImmOrigin, C: def(var Self.V) raises Never -> R, //, J: Functor = _NativeFamily[R]](deinit self, ref[o] function: C) raises Never -> Pipeline[J, R, Self.E] where Self.E != Never:
        """Consume the whole value with one stage and select its output family."""
        return Pipeline[J, R, Self.E](call_once(_NativeUnaryRef[Self.V, R, Never, C, True, o](Pointer(to=function)), rebind_var[_NativeUnaryRef[Self.V, R, Never, C, True, o].Arg](self.value^)))

    @always_inline
    def then[R: Movable & Deinitable, //, J: Functor = _NativeFamily[R]](deinit self, function: def(var Self.V) raises Never thin -> R) raises Never -> Pipeline[J, R, Self.E]:
        """Consume the whole value with one stage and select its output family."""
        return Pipeline[J, R, Self.E](call_once(NativeUnary[Self.V, R, Never, def(var Self.V) raises Never thin -> R, True](function), rebind_var[NativeUnary[Self.V, R, Never, def(var Self.V) raises Never thin -> R, True].Arg](self.value^)))

    @always_inline
    def fold_left[A: Movable & Deinitable, C: Binary](deinit self, var step: C, var initial: A) raises C.Error -> Pipeline[_NativeFamily[A], A, Self.E] where C.First == A and C.Second == _FoldElement[Self.V] and C.Out == A:
        """Consume the source in order through the canonical terminal fold.

        Parameters:
            A: The accumulator type, inferred from the initial value and preserved by every step.
            C: The first library callback type, retaining its receiver and origins.

        Args:
            step: The fold step; native callbacks are borrowed, library Binary steps consumed.
            initial: The initial accumulator, consumed.

        Returns:
            The pipeline containing the operation result, retaining its selected native error.

        Raises:
            The exact callback or family error; it never becomes a stored Result error.
        """
        return Pipeline[_NativeFamily[A], A, Self.E](_context_fold_left(step, initial^, self.value^))

    @always_inline
    def fold_left[A: Movable & Deinitable, R: Movable & Deinitable, o: ImmOrigin, //, C: def(var A, var _FoldElement[Self.V]) -> R](deinit self, ref[o] step: C, var initial: A) raises Never -> Pipeline[_NativeFamily[A], A, Self.E] where R == A:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[A], A, Self.E](_context_fold_left(_NativeBinaryRef[A, _FoldElement[Self.V], R, Never, C, False, o](Pointer(to=step)), initial^, self.value^))

    @always_inline
    def fold_left[A: Movable & Deinitable, R: Movable & Deinitable, o: ImmOrigin, //, C: def(var A, var _FoldElement[Self.V]) raises Self.E -> R](deinit self, ref[o] step: C, var initial: A) raises Self.E -> Pipeline[_NativeFamily[A], A, Self.E] where R == A:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[A], A, Self.E](_context_fold_left(_NativeBinaryRef[A, _FoldElement[Self.V], R, Self.E, C, True, o](Pointer(to=step)), initial^, self.value^))

    @always_inline
    def fold_left[A: Movable & Deinitable, R: Movable & Deinitable, o: ImmOrigin, //, C: def(var A, var _FoldElement[Self.V]) raises Never -> R](deinit self, ref[o] step: C, var initial: A) raises Never -> Pipeline[_NativeFamily[A], A, Self.E] where Self.E != Never and R == A:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[A], A, Self.E](_context_fold_left(_NativeBinaryRef[A, _FoldElement[Self.V], R, Never, C, True, o](Pointer(to=step)), initial^, self.value^))

    @always_inline
    def reduce_optional[C: Binary](deinit self, var step: C) raises C.Error -> Pipeline[_NativeFamily[Optional[C.Out]], Optional[C.Out], Self.E] where C.First == _FoldElement[Self.V] and C.Second == _FoldElement[Self.V] and C.Out == _FoldElement[Self.V]:
        """Consume the source in order through the canonical terminal fold.

        Parameters:
            C: The first library callback type, retaining its receiver and origins.

        Args:
            step: The fold step; native callbacks are borrowed, library Binary steps consumed.

        Returns:
            The pipeline containing the operation result, retaining its selected native error.

        Raises:
            The exact callback or family error; it never becomes a stored Result error.
        """
        return Pipeline[_NativeFamily[Optional[C.Out]], Optional[C.Out], Self.E](_context_reduce_optional(step, self.value^))

    @always_inline
    def reduce_optional[R: Movable & Deinitable, o: ImmOrigin, //, C: def(var _FoldElement[Self.V], var _FoldElement[Self.V]) -> R](deinit self, ref[o] step: C) raises Never -> Pipeline[_NativeFamily[Optional[R]], Optional[R], Self.E] where R == _FoldElement[Self.V]:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[Optional[R]], Optional[R], Self.E](_context_reduce_optional(_NativeBinaryRef[_FoldElement[Self.V], _FoldElement[Self.V], R, Never, C, False, o](Pointer(to=step)), self.value^))

    @always_inline
    def reduce_optional[R: Movable & Deinitable, o: ImmOrigin, //, C: def(var _FoldElement[Self.V], var _FoldElement[Self.V]) raises Self.E -> R](deinit self, ref[o] step: C) raises Self.E -> Pipeline[_NativeFamily[Optional[R]], Optional[R], Self.E] where R == _FoldElement[Self.V]:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[Optional[R]], Optional[R], Self.E](_context_reduce_optional(_NativeBinaryRef[_FoldElement[Self.V], _FoldElement[Self.V], R, Self.E, C, True, o](Pointer(to=step)), self.value^))

    @always_inline
    def reduce_optional[R: Movable & Deinitable, o: ImmOrigin, //, C: def(var _FoldElement[Self.V], var _FoldElement[Self.V]) raises Never -> R](deinit self, ref[o] step: C) raises Never -> Pipeline[_NativeFamily[Optional[R]], Optional[R], Self.E] where Self.E != Never and R == _FoldElement[Self.V]:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[Optional[R]], Optional[R], Self.E](_context_reduce_optional(_NativeBinaryRef[_FoldElement[Self.V], _FoldElement[Self.V], R, Never, C, True, o](Pointer(to=step)), self.value^))

    @always_inline
    def fold_until[A: Movable & Deinitable, C: Binary, //, B: Movable & Deinitable](deinit self, var step: C, var initial: A) raises C.Error -> Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E] where C.First == A and C.Second == _FoldElement[Self.V] and C.Out == ControlFlow[B, A]:
        """Consume the source in order through the canonical terminal fold.

        Parameters:
            A: The accumulator type, inferred from the initial value and preserved by every step.
            C: The first library callback type, retaining its receiver and origins.
            B: The early termination payload, including its origins.

        Args:
            step: The fold step; native callbacks are borrowed, library Binary steps consumed.
            initial: The initial accumulator, consumed.

        Returns:
            The pipeline containing the operation result, retaining its selected native error.

        Raises:
            The exact callback or family error; it never becomes a stored Result error.
        """
        return Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E](_context_fold_until[B=B](step, initial^, self.value^))

    @always_inline
    def fold_until[A: Movable & Deinitable, B: Movable & Deinitable, o: ImmOrigin, //, C: def(var A, var _FoldElement[Self.V]) -> ControlFlow[B, A]](deinit self, ref[o] step: C, var initial: A) raises Never -> Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E] where ControlFlow[B, A] == ControlFlow[B, A]:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E](_context_fold_until[B=B](_NativeBinaryRef[A, _FoldElement[Self.V], ControlFlow[B, A], Never, C, False, o](Pointer(to=step)), initial^, self.value^))

    @always_inline
    def fold_until[A: Movable & Deinitable, B: Movable & Deinitable, o: ImmOrigin, //, C: def(var A, var _FoldElement[Self.V]) raises Self.E -> ControlFlow[B, A]](deinit self, ref[o] step: C, var initial: A) raises Self.E -> Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E] where ControlFlow[B, A] == ControlFlow[B, A]:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E](_context_fold_until[B=B](_NativeBinaryRef[A, _FoldElement[Self.V], ControlFlow[B, A], Self.E, C, True, o](Pointer(to=step)), initial^, self.value^))

    @always_inline
    def fold_until[A: Movable & Deinitable, B: Movable & Deinitable, o: ImmOrigin, //, C: def(var A, var _FoldElement[Self.V]) raises Never -> ControlFlow[B, A]](deinit self, ref[o] step: C, var initial: A) raises Never -> Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E] where Self.E != Never and ControlFlow[B, A] == ControlFlow[B, A]:
        """Consume the source in order through the canonical terminal fold."""
        return Pipeline[_NativeFamily[ControlFlow[B, A]], ControlFlow[B, A], Self.E](_context_fold_until[B=B](_NativeBinaryRef[A, _FoldElement[Self.V], ControlFlow[B, A], Never, C, True, o](Pointer(to=step)), initial^, self.value^))

    @always_inline
    def traverse[C: UnaryContract & Movable & Deinitable, //, J: Applicative](deinit self, var function: C) raises _Traversing[Self.I].TraverseError[J, Self.V, C] -> Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, C], Self.E] where conforms_to(Self.I, Traversable) and C.Arg == Self.I.Element[Self.V] and _CollectCompatible[J, Self.V, C] and _CarrierCompatible[J, C.Out]:
        """Traverse into the selected target effect and continue in that family.

        Parameters:
            C: The first library callback type, retaining its receiver and origins.
            J: The output family; inferred for whole-value stages, explicit for traversal.

        Args:
            function: The callback; native callbacks are borrowed, library callbacks consumed.

        Returns:
            The pipeline containing the operation result, retaining its selected native error.

        Raises:
            The exact callback or family error; it never becomes a stored Result error.
        """
        return Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, C], Self.E](_Traversing[Self.I].traverse[J](function^, self.value^))

    @always_inline
    def traverse[R: Movable & Deinitable, o: ImmOrigin, //, J: Applicative, C: def(var Self.I.Element[Self.V]) -> R](deinit self, ref[o] function: C) raises _Traversing[Self.I].TraverseError[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]] -> Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]], Self.E] where conforms_to(Self.I, Traversable) and _CollectCompatible[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]] and _CarrierCompatible[J, R]:
        """Traverse into the selected target effect and continue in that family."""
        return Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]], Self.E](_Traversing[Self.I].traverse[J](_NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o](Pointer(to=function)), self.value^))

    @always_inline
    def traverse[R: Movable & Deinitable, //, J: Applicative](deinit self, function: def(var Self.I.Element[Self.V]) thin -> R) raises _Traversing[Self.I].TraverseError[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]] -> Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]], Self.E] where conforms_to(Self.I, Traversable) and _CollectCompatible[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]] and _CarrierCompatible[J, R]:
        """Traverse into the selected target effect and continue in that family."""
        return Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]], Self.E](_Traversing[Self.I].traverse[J](NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False](function), self.value^))

    @always_inline
    def traverse[R: Movable & Deinitable, o: ImmOrigin, //, J: Applicative, C: def(var Self.I.Element[Self.V]) raises Self.E -> R](deinit self, ref[o] function: C) raises _Traversing[Self.I].TraverseError[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o]] -> Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o]], Self.E] where conforms_to(Self.I, Traversable) and _CollectCompatible[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o]] and _CarrierCompatible[J, R]:
        """Traverse into the selected target effect and continue in that family."""
        return Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o]], Self.E](_Traversing[Self.I].traverse[J](_NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o](Pointer(to=function)), self.value^))

    @always_inline
    def traverse[R: Movable & Deinitable, o: ImmOrigin, //, J: Applicative, C: def(var Self.I.Element[Self.V]) raises Never -> R](deinit self, ref[o] function: C) raises _Traversing[Self.I].TraverseError[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o]] -> Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o]], Self.E] where conforms_to(Self.I, Traversable) and Self.E != Never and _CollectCompatible[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o]] and _CarrierCompatible[J, R]:
        """Traverse into the selected target effect and continue in that family."""
        return Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o]], Self.E](_Traversing[Self.I].traverse[J](_NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o](Pointer(to=function)), self.value^))

    @always_inline
    def traverse[R: Movable & Deinitable, //, J: Applicative](deinit self, function: def(var Self.I.Element[Self.V]) raises Never thin -> R) raises _Traversing[Self.I].TraverseError[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) raises Never thin -> R, True]] -> Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) raises Never thin -> R, True]], Self.E] where conforms_to(Self.I, Traversable) and _CollectCompatible[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) raises Never thin -> R, True]] and _CarrierCompatible[J, R]:
        """Traverse into the selected target effect and continue in that family."""
        return Pipeline[J, _Traversing[Self.I].Traversed[J, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) raises Never thin -> R, True]], Self.E](_Traversing[Self.I].traverse[J](NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) raises Never thin -> R, True](function), self.value^))

    @always_inline
    def map2[W: Movable & Deinitable, C: BinaryContract & Movable & Deinitable](deinit self, var other: W, var function: C) raises _Combining[Self.I].CombineError[Self.V, C, _ValueThunk[W]] -> Pipeline[Self.I, _Combining[Self.I].Combined[Self.V, C, _ValueThunk[W]], Self.E] where conforms_to(Self.I, Applicative) and C.First == Self.I.Element[Self.V] and C.Second == Self.I.Element[W] and _CombineCompatible[_Combining[Self.I], Self.V, C, _ValueThunk[W]] and _CarrierCompatible[_Combining[Self.I], Self.V] and _CarrierCompatible[_Combining[Self.I], W]:
        """Combine two evaluated carriers through the selected Applicative family.

        Parameters:
            W: The second carrier type, including its origins.
            C: The first library callback type, retaining its receiver and origins.

        Args:
            other: The already evaluated second carrier, consumed.
            function: The callback; native callbacks are borrowed, library callbacks consumed.

        Returns:
            The pipeline containing the operation result, retaining its selected native error.

        Raises:
            The exact callback or family error; it never becomes a stored Result error.
        """
        return Pipeline[Self.I, _Combining[Self.I].Combined[Self.V, C, _ValueThunk[W]], Self.E](_map2_as[_Combining[Self.I], X=_Combining[Self.I].CombineError[Self.V, C, _ValueThunk[W]]](function^, self.value^, other^))

    @always_inline
