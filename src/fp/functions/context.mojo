        return Pipeline[Self.I, Self.I.Mapped[Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) raises Never thin -> R, True]], Self.E](Self.I.map(NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) raises Never thin -> R, True](function), self.value^))

    @always_inline
    def filter[C: BorrowCallable](deinit self, var predicate: C) raises _Filtering[Self.I].FilterError[Self.V, C] -> Pipeline[Self.I, _Filtering[Self.I].Filtered[Self.V, C], Self.E] where conforms_to(Self.I, Filterable) and C.Payload == Self.I.Element[Self.V] and C.Result == Bool:
