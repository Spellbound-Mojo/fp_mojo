    @always_inline
    def tap[R: RegisterPassable & Deinitable, //](deinit self, function: def(Self.V) thin -> R) raises Never -> Pipeline[Self.I, Self.V, Self.E] where not conforms_to(Self.V, TrivialRegisterPassable):
