    @always_inline
    def tap[R: Movable & Deinitable, o: ImmOrigin, //, C: def(Self.V) raises Never -> R](deinit self, ref[o] function: C) raises Never -> Pipeline[Self.I, Self.V, Self.E] where Self.E != Never:
        """Inspect the whole value once now and retain it unchanged."""
