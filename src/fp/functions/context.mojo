    @always_inline
    def map[R: Movable & Deinitable, o: ImmOrigin, //, C: def(var Self.I.Element[Self.V]) raises Never -> R](deinit self, ref[o] function: C) raises Self.I.MapError[Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o]] -> Pipeline[Self.I, Self.I.Mapped[Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o]], Self.E] where conforms_to(Self.I, Functor) and Self.E != Never and _MapCompatible[Self.I, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, True, o]]:
