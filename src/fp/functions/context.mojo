def pipeline[T: Movable & Deinitable](var value: List[T]) -> Pipeline[ListFamily, List[T]]:
    """Select the carrier family before admitting any callback.

    Parameters:
        T: The carrier payload type.

    Args:
        value: The carrier, consumed.

    Returns:
        The pipeline containing the operation result, retaining its selected native error.
    """
    return Pipeline[ListFamily, List[T]](value^)
def pipeline[T: Movable & Deinitable](var value: Optional[T]) -> Pipeline[OptionalFamily, Optional[T]]:
    """Select the carrier family before admitting any callback."""
    return Pipeline[OptionalFamily, Optional[T]](value^)
def pipeline[T: Movable & Deinitable, E: Movable & Deinitable](var value: Result[T, E]) -> Pipeline[ResultFamily[E], Result[T, E]]:
    """Select the carrier family before admitting any callback."""
    return Pipeline[ResultFamily[E], Result[T, E]](value^)
def pipeline[V: Movable & Deinitable, //, I: Functor](var value: V) -> Pipeline[I, V]:
    """Select a native carrier family, Identity for a bare value, or an explicit Functor.

    Parameters:
        V: The complete carrier type.
        I: The explicit Functor family, including its evaluation and error semantics.

    Args:
        value: The carrier, consumed.

    Returns:
        The pipeline containing the operation result, retaining its selected native error.
    """
    return Pipeline[I, V](value^)

def pipeline[V: Movable & Deinitable](var value: V) -> Pipeline[_NativeFamily[V], V] where _NativeFamily[V] == IdentityFamily:
    """Start a pipeline over a bare value with the Identity family."""
    return Pipeline[_NativeFamily[V], V](value^)
