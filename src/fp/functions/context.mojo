"""Select family and native errors before callback inference; reuse algebra execution."""
from std.builtin.rebind import downcast, rebind_var
from fp._internal.errors import _CommonError
from fp.data._result import _ResultType
from fp.algebra.protocols import Functor, Filterable, Monad, FunctorFilter
from fp.algebra.instances import ListFamily, OptionalFamily, ResultFamily
from fp.algebra._admission import _MapCompatible, _BindCompatible
from fp.callables.native import _NativeUnaryRef, _NativeBorrowRef, _NativeBorrow, _NativeThunkRef, NativeUnary
from fp.callables.protocols import UnaryContract, BorrowCallable, BorrowCallContract, ThunkContract
from fp.data._result import Result

comptime _Filtering[I: Functor] = downcast[I, Filterable]
comptime _Binding[I: Functor] = downcast[I, Monad]
comptime _Compacting[I: Functor] = downcast[I, FunctorFilter]
comptime _Success[V: Movable & Deinitable] = downcast[V, _ResultType].Value
comptime _Failure[V: Movable & Deinitable] = downcast[V, _ResultType].Error

@fieldwise_init
struct Pipeline[I: Functor, V: Movable & Deinitable, E: Movable & Deinitable = Never](Movable):
    """A carrier with its family and native callback error selected before inference.

    Start with `pipeline(value)` for List, Optional or Result, or
    `pipeline[Family](value)` for an explicit Functor. Select a native error
    once with `raising[E]()`. Pure callbacks keep Never; library callbacks
    keep their declared errors. `get()` extracts the value. Map, flat_map,
    filter and filter_map delegate to the family's evaluation and ownership
    rules, including deferred execution and retained callback borrows.

    Result-specific methods delegate to Result and update ResultFamily when
    the stored error type changes. Native raised errors remain raised;
    use Capture to store them. Existing Piped and piped remain available.

    Parameters:
        I: The selected carrier family.
        V: The complete carrier type, including its origins.
        E: The native callback error, selected before inference; Never by default.
    """
    var value: Self.V
    """The carrier owned by this pipeline."""

    def raising[X: Movable & Deinitable](deinit self) -> Pipeline[Self.I, Self.V, X]:
        """Select the native callback error for following stages.

        Parameters:
            X: The native error type; independent of a Result's stored error.

        Returns:
            The same carrier and family with the selected native error.
        """
        return Pipeline[Self.I, Self.V, X](self.value^)

    def get(deinit self) -> Self.V:
        """Consume the pipeline and extract its carrier without evaluating it.

        Returns:
            The carrier with its original ownership and origins.
        """
        return self.value^

    # --- selected context methods (generated) ---
    # Generated by scripts/generate_context.py; callbacks adapt signatures only.

    @always_inline
    def map[C: UnaryContract & Movable & Deinitable](deinit self, var function: C) raises Self.I.MapError[Self.V, C] -> Pipeline[Self.I, Self.I.Mapped[Self.V, C], Self.E] where conforms_to(Self.I, Functor) and C.Arg == Self.I.Element[Self.V] and _MapCompatible[Self.I, Self.V, C]:
        """Apply map through the selected family's Functor capability.

        Parameters:
            C: The first library callback type, retaining its receiver and origins.

        Args:
            function: The callback; native callbacks are borrowed, library callbacks consumed.

        Returns:
            The pipeline containing the operation result, retaining its selected native error.

        Raises:
            The exact callback or family error; it never becomes a stored Result error.
        """
        return Pipeline[Self.I, Self.I.Mapped[Self.V, C], Self.E](Self.I.map(function^, self.value^))

    @always_inline
    def map[R: Movable & Deinitable, o: ImmOrigin, //, C: def(var Self.I.Element[Self.V]) -> R](deinit self, ref[o] function: C) raises Self.I.MapError[Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]] -> Pipeline[Self.I, Self.I.Mapped[Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]], Self.E] where conforms_to(Self.I, Functor) and _MapCompatible[Self.I, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]]:
        """Apply map through the selected family's Functor capability."""
        return Pipeline[Self.I, Self.I.Mapped[Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o]], Self.E](Self.I.map(_NativeUnaryRef[Self.I.Element[Self.V], R, Never, C, False, o](Pointer(to=function)), self.value^))

    @always_inline
    def map[R: Movable & Deinitable, //](deinit self, function: def(var Self.I.Element[Self.V]) thin -> R) raises Self.I.MapError[Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]] -> Pipeline[Self.I, Self.I.Mapped[Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]], Self.E] where conforms_to(Self.I, Functor) and _MapCompatible[Self.I, Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]]:
        """Apply map through the selected family's Functor capability."""
        return Pipeline[Self.I, Self.I.Mapped[Self.V, NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False]], Self.E](Self.I.map(NativeUnary[Self.I.Element[Self.V], R, Never, def(var Self.I.Element[Self.V]) thin -> R, False](function), self.value^))

    @always_inline
    def map[R: Movable & Deinitable, o: ImmOrigin, //, C: def(var Self.I.Element[Self.V]) raises Self.E -> R](deinit self, ref[o] function: C) raises Self.I.MapError[Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o]] -> Pipeline[Self.I, Self.I.Mapped[Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o]], Self.E] where conforms_to(Self.I, Functor) and _MapCompatible[Self.I, Self.V, _NativeUnaryRef[Self.I.Element[Self.V], R, Self.E, C, True, o]]:
