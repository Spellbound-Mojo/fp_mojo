    @always_inline
    def tap[R: Movable & Deinitable, o: ImmOrigin, //, C: def(Self.V) raises Self.E -> R](deinit self, ref[o] function: C) raises Self.E -> Pipeline[Self.I, Self.V, Self.E]:
